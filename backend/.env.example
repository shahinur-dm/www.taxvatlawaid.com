# Server
NODE_ENV=development
PORT=5000

# Database (Required for production / local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/taxvat_lawaid

# Optional: Set to true ONLY for local demo without an external MongoDB instance
# USE_IN_MEMORY_DB=false

# JWT Authentication (Use a strong 32+ char random secret in production)
JWT_SECRET=replace_with_a_strong_64_char_random_secret_string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Timezone
TIMEZONE=Asia/Dhaka

# Initial Admin Seed Credentials (Used only by `npm run seed`)
SEED_ADMIN_NAME=Hossain Ahmed (Khan)
SEED_ADMIN_EMAIL=admin@taxvatlawaid.com
SEED_ADMIN_PASSWORD=ChangeMeStrongPassword!2026

