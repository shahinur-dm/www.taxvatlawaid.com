{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "bindings": {
        "BACKEND_INTERNAL_URL": {
          "service": "backend"
        }
      }
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.ts",
      "buildCommand": ""
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/$1"
      }
    }
  ]
}
